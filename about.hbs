<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>WiFiSight Third-Party Licenses</title>
<style>
body { font-family: sans-serif; max-width: 860px; margin: 0 auto; padding: 0 16px; }
@media (prefers-color-scheme: dark) { body { background: #222; color: #ddd; } a { color: skyblue; } }
pre { white-space: pre-wrap; font-size: 12px; }
</style>
</head>
<body>
<h1>Third-Party Licenses</h1>
<p>WiFiSight includes the following third-party software.</p>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}<li><a href="#npm">npm packages</a> (2)</li>
</ul>
{{#each licenses}}
{{#if first_of_kind}}<h2 id="{{id}}">{{name}}</h2>{{/if}}
<p>Used by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}</p>
<pre>{{text}}</pre>
{{/each}}
<h2 id="npm">npm packages</h2>
<p>Used by: @tauri-apps/api, @tauri-apps/plugin-dialog (MIT OR Apache-2.0; MIT chosen)</p>
