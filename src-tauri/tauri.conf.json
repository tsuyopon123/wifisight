{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFiSight",
  "version": "0.1.0",
  "identifier": "dev.tsuyopon.wifisight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WiFiSight",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Wi-Fi scanner / survey tool",
    "resources": {
      "../THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libcap2-bin"],
        "postInstallScript": "deb/postinst"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0N0Y0MkQzRkE5NjUxNjkKUldScFVaYjYwMEovOUZ3bUhPMHRmNWFaMXJaZDJOSWE4bExJdTVTNms4RStrdE9IdkRPSWtLZisK",
      "endpoints": ["https://github.com/tsuyopon123/wifisight/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
