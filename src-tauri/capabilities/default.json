{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/tsuyopon123/wifisight/*"
        }
      ]
    }
  ]
}
